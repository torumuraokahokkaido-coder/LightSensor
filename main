                        <option value="2">2秒周期</option>
                        <option value="5">5秒周期</option>
                        <option value="10">10秒周期</option>
                    </select>

                    <button id="btnExportCSV" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 rounded-xl text-xs font-medium transition-all flex items-center gap-1">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                        CSV出力
                    </button>
                    
                    <button id="btnClearLogs" class="px-2 py-1.5 bg-slate-800 hover:bg-red-900/30 text-slate-400 hover:text-red-300 border border-slate-700 rounded-xl text-xs transition-all">
                        消去
                    </button>
                </div>
            </div>

            <!-- ログテーブル表示 -->
            <div class="max-h-48 overflow-y-auto border border-slate-800 rounded-xl">
                <table class="w-full text-left text-xs">
                    <thead class="bg-slate-950 text-slate-400 sticky top-0 border-b border-slate-800">
                        <tr>
                            <th class="p-2.5 font-medium">時刻</th>
                            <th class="p-2.5 font-medium">照度 (lx)</th>
                            <th class="p-2.5 font-medium">照度 (fc)</th>
                            <th class="p-2.5 font-medium">環境区分</th>
                        </tr>
                    </thead>
                    <tbody id="logTableBody" class="divide-y divide-slate-800/50 text-slate-300">
                        <tr>
                            <td colspan="4" class="p-4 text-center text-slate-500 italic">記録されたログはありません</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

    </div>

    <!-- モード切り替えモーダルダイアログ -->
    <div id="modeModal" class="fixed inset-0 bg-black/70 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-slate-900 border border-slate-800 rounded-3xl max-w-md w-full p-6 space-y-4 shadow-2xl">
            <div class="flex justify-between items-center border-b border-slate-800 pb-3">
                <h3 class="font-bold text-slate-100 flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20v-2M12 4V2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41M2 12h2M20 12h2M6.34 6.34 4.93 4.93M19.07 19.07l-1.41-1.41"/></svg>
                    計測モードの選択
                </h3>
                <button id="btnCloseModal" class="text-slate-400 hover:text-slate-200">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
            </div>

            <div class="space-y-3">
                <!-- モード1: 環境光センサー -->
                <button id="optSensorMode" class="w-full p-3.5 bg-slate-800 hover:bg-slate-700/80 border border-slate-700 rounded-2xl text-left transition-all flex items-start space-x-3">
                    <div class="p-2 bg-emerald-500/10 text-emerald-400 rounded-xl mt-0.5">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
                    </div>
                    <div>
                        <p class="font-bold text-sm text-slate-100">環境光センサー (AmbientLightSensor)</p>
                        <p class="text-xs text-slate-400 mt-0.5">内蔵光センサーで直接計測します（Android Chrome等で対応）。</p>
                    </div>
                </button>

                <!-- モード2: カメラ輝度解析 -->
                <button id="optCameraMode" class="w-full p-3.5 bg-slate-800 hover:bg-slate-700/80 border border-slate-700 rounded-2xl text-left transition-all flex items-start space-x-3">
                    <div class="p-2 bg-cyan-500/10 text-cyan-400 rounded-xl mt-0.5">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/><circle cx="12" cy="13" r="3"/></svg>
                    </div>
                    <div>
                        <p class="font-bold text-sm text-slate-100">カメラ輝度解析モード (簡易計測)</p>
                        <p class="text-xs text-slate-400 mt-0.5">カメラ映像の平均輝度から近似の照度(lx)をリアルタイム推定します。</p>
                    </div>
                </button>

                <!-- モード3: デモシミュレーター -->
                <button id="optDemoMode" class="w-full p-3.5 bg-slate-800 hover:bg-slate-700/80 border border-slate-700 rounded-2xl text-left transition-all flex items-start space-x-3">
                    <div class="p-2 bg-amber-500/10 text-amber-400 rounded-xl mt-0.5">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/><path d="M16 16h5v5"/></svg>
                    </div>
                    <div>
                        <p class="font-bold text-sm text-slate-100">デモ・シミュレーター</p>
                        <p class="text-xs text-slate-400 mt-0.5">動作確認用の動的なダミー数値を自動生成します。</p>
                    </div>
                </button>
            </div>
        </div>
    </div>

    <!-- トースト通知 -->
    <div id="toast" class="toast fixed bottom-5 right-5 bg-slate-800 border border-slate-700 text-slate-100 px-4 py-3 rounded-2xl shadow-2xl z-50 flex items-center space-x-2 text-xs font-medium">
        <span id="toastIcon" class="text-emerald-400">✓</span>
        <span id="toastMessage">メッセージ</span>
    </div>

    <script>
        // アプリケーション状態管理
        const state = {
            mode: 'SENSOR', // 'SENSOR', 'CAMERA', 'DEMO'
            unit: 'lx', // 'lx', 'fc'
            calibration: 1.0,
            isHold: false,
            rawLux: 0,
            calibratedLux: 0,
            stats: {
                min: Infinity,
                max: 0,
                sum: 0,
                count: 0
            },
            logs: [],
            autoLogIntervalSec: 0,
            autoLogTimer: null,
            demoTimer: null,
            cameraStream: null,
            cameraTimer: null,
            sensorObj: null
        };

        // CONSTANTS
        const FC_CONVERSION_FACTOR = 10.76391; // 1 fc ≈ 10.76391 lx

        // DOM Elements
        const mainValueDisplay = document.getElementById('mainValueDisplay');
        const unitDisplay = document.getElementById('unitDisplay');
        const currentCalibDisplay = document.getElementById('currentCalibDisplay');
        const gaugeNeedle = document.getElementById('gaugeNeedle');
        const envCategoryTag = document.getElementById('envCategoryTag');
        const holdBanner = document.getElementById('holdBanner');

        const statMinVal = document.getElementById('statMinVal');
        const statMaxVal = document.getElementById('statMaxVal');
        const statAvgVal = document.getElementById('statAvgVal');
        const statCountVal = document.getElementById('statCountVal');

        const sensorStatusText = document.getElementById('sensorStatusText');
        const sensorStatusDot = document.getElementById('sensorStatusDot');
        const sliderCalibration = document.getElementById('sliderCalibration');
        const calibValueLabel = document.getElementById('calibValueLabel');

        const btnHold = document.getElementById('btnHold');
        const btnToggleUnit = document.getElementById('btnToggleUnit');
        const btnResetStats = document.getElementById('btnResetStats');
        const btnLogCurrent = document.getElementById('btnLogCurrent');

        const btnToggleRefGuide = document.getElementById('btnToggleRefGuide');
        const panelRefGuide = document.getElementById('panelRefGuide');
        const arrowRefGuide = document.getElementById('arrowRefGuide');

        const btnModeSelector = document.getElementById('btnModeSelector');
        const modeModal = document.getElementById('modeModal');
        const btnCloseModal = document.getElementById('btnCloseModal');
        const optSensorMode = document.getElementById('optSensorMode');
        const optCameraMode = document.getElementById('optCameraMode');
        const optDemoMode = document.getElementById('optDemoMode');

        const logTableBody = document.getElementById('logTableBody');
        const logCountBadge = document.getElementById('logCountBadge');
        const btnExportCSV = document.getElementById('btnExportCSV');
        const btnClearLogs = document.getElementById('btnClearLogs');
        const selectAutoLogInterval = document.getElementById('selectAutoLogInterval');

        // メーターの角度計算 (対数スケール: 1lx = -120deg, 100,000lx = +120deg)
        function calculateGaugeAngle(lux) {
            if (lux <= 0) return -120;
            const logMin = Math.log10(1);      // 0
            const logMax = Math.log10(100000); // 5
            const clampedLux = Math.max(1, Math.min(lux, 100000));
            const logVal = Math.log10(clampedLux);

            // 0 -> -120deg, 5 -> +120deg (Total range: 240deg)
            const ratio = (logVal - logMin) / (logMax - logMin);
            return -120 + ratio * 240;
        }

        // 照度に応じた環境カテゴリ判別
        function getEnvironmentCategory(lux) {
            if (lux < 2) return { text: "暗闇・月光 (非常に暗い)", color: "text-indigo-400" };
            if (lux < 50) return { text: "街灯下・夜間歩道", color: "text-blue-400" };
            if (lux < 150) return { text: "廊下・階段・室内照明", color: "text-cyan-400" };
            if (lux < 400) return { text: "住宅リビング (標準)", color: "text-emerald-400" };
            if (lux < 800) return { text: "オフィス・読書デスク", color: "text-yellow-400" };
            if (lux < 2000) return { text: "精密作業・展示スペース", color: "text-amber-400" };
            if (lux < 10000) return { text: "日陰の屋外・窓際", color: "text-orange-400" };
            return { text: "直射日光・晴天屋外", color: "text-red-400" };
        }

        // 数値フォーマット（単位変換含む）
        function formatVal(luxVal) {
            const val = state.unit === 'fc' ? luxVal / FC_CONVERSION_FACTOR : luxVal;
            if (val >= 10000) return Math.round(val).toLocaleString();
            if (val >= 100) return val.toFixed(1);
            if (val >= 10) return val.toFixed(2);
            return val.toFixed(2);
        }

        // UI更新メイン関数
        function processNewLuxReading(rawLux) {
            if (state.isHold) return;

            state.rawLux = rawLux;
            state.calibratedLux = rawLux * state.calibration;

            const currentLux = state.calibratedLux;

            // 統計計算
            if (currentLux < state.stats.min) state.stats.min = currentLux;
            if (currentLux > state.stats.max) state.stats.max = currentLux;
            state.stats.sum += currentLux;
            state.stats.count += 1;

            updateUI();
        }

        function updateUI() {
            const currentLux = state.calibratedLux;

            // 1. メイン数値表示
            mainValueDisplay.innerText = formatVal(currentLux);

            // 2. ゲージ針の角度更新
            const angle = calculateGaugeAngle(currentLux);
            gaugeNeedle.style.transform = `rotate(${angle}deg)`;

            // 3. 環境カテゴリ表示
            const cat = getEnvironmentCategory(currentLux);
            envCategoryTag.innerText = cat.text;
            envCategoryTag.className = `px-3 py-1 bg-slate-800/90 border border-slate-700 rounded-full text-xs font-medium inline-block shadow ${cat.color}`;

            // 4. 統計データカード更新
            if (state.stats.count > 0) {
                statMinVal.innerText = formatVal(state.stats.min);
                statMaxVal.innerText = formatVal(state.stats.max);
                const avg = state.stats.sum / state.stats.count;
                statAvgVal.innerText = formatVal(avg);
                statCountVal.innerText = state.stats.count.toLocaleString();
            }

            // 単位表示の同期
            unitDisplay.innerText = state.unit;
            document.querySelectorAll('.statUnit').forEach(el => el.innerText = state.unit);
            currentCalibDisplay.innerText = `${state.calibration.toFixed(1)}x`;
        }

        // モード変更＆センサー制御
        function switchMode(newMode) {
            stopAllSensors();
            state.mode = newMode;

            if (newMode === 'SENSOR') {
                initAmbientLightSensor();
            } else if (newMode === 'CAMERA') {
                initCameraLuminanceSensor();
            } else if (newMode === 'DEMO') {
                initDemoSimulator();
            }

            modeModal.classList.add('hidden');
        }

        function stopAllSensors() {
            // Stop Ambient Light Sensor
            if (state.sensorObj) {
                try { state.sensorObj.stop(); } catch (e) {}
                state.sensorObj = null;
            }
            // Stop Camera
            if (state.cameraStream) {
                state.cameraStream.getTracks().forEach(track => track.stop());
                state.cameraStream = null;
            }
            if (state.cameraTimer) {
                clearInterval(state.cameraTimer);
                state.cameraTimer = null;
            }
            // Stop Demo
            if (state.demoTimer) {
                clearInterval(state.demoTimer);
                state.demoTimer = null;
            }
        }

        // 1. AmbientLightSensor モード
        function initAmbientLightSensor() {
            sensorStatusText.innerText = "環境光センサー";
            sensorStatusDot.className = "w-2 h-2 rounded-full bg-emerald-500 animate-pulse";

            if ('AmbientLightSensor' in window) {
                try {
                    state.sensorObj = new AmbientLightSensor();
                    state.sensorObj.onreading = () => {
                        processNewLuxReading(state.sensorObj.illuminance);
                    };
                    state.sensorObj.onerror = (event) => {
                        console.warn("AmbientLightSensorエラー:", event.error);
                        showToast("環境光センサーを使用できません。カメラモードに切替えます");
                        switchMode('CAMERA');
                    };
                    state.sensorObj.start();
                } catch (e) {
                    showToast("光センサーのアクセス権限がありません。カメラモードに移行します");
                    switchMode('CAMERA');
                }
            } else {
                showToast("非対応ブラウザのためカメラ輝度解析モードに移行します");
                switchMode('CAMERA');
            }
        }

        // 2. カメラ輝度解析モード (簡易照度計算)
        async function initCameraLuminanceSensor() {
            sensorStatusText.innerText = "カメラ輝度解析";
            sensorStatusDot.className = "w-2 h-2 rounded-full bg-cyan-500 animate-pulse";

            const video = document.getElementById('cameraVideo');
            const canvas = document.getElementById('cameraCanvas');
            const ctx = canvas.getContext('2d');

            try {
                state.cameraStream = await navigator.mediaDevices.getUserMedia({
                    video: { facingMode: 'environment', width: { ideal: 320 }, height: { ideal: 240 } }
                });
                video.srcObject = state.cameraStream;

                state.cameraTimer = setInterval(() => {
                    if (video.readyState === video.HAVE_ENOUGH_DATA) {
                        ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
                        const imgData = ctx.getImageData(0, 0, canvas.width, canvas.height);
                        const data = imgData.data;

                        let totalLuminance = 0;
                        for (let i = 0; i < data.length; i += 4) {
                            const r = data[i];
                            const g = data[i + 1];
                            const b = data[i + 2];
                            // 相対輝度計算 (Rec. 709)
                            const lum = 0.2126 * r + 0.7152 * g + 0.0722 * b;
                            totalLuminance += lum;
                        }

                        const avgLum = totalLuminance / (data.length / 4); // 0 ～ 255
                        // 輝度(0-255)から対数近似で照度(0-2000lx)を推定
                        const estimatedLux = Math.pow(avgLum / 255, 2.5) * 2000;
                        processNewLuxReading(estimatedLux);
                    }
                }, 200);

            } catch (err) {
                console.error("Camera access failed:", err);
                showToast("カメラアクセスが拒否されました。デモモードを起動します");
                switchMode('DEMO');
            }
        }

        // 3. デモモード
        function initDemoSimulator() {
            sensorStatusText.innerText = "デモシミュレーター";
            sensorStatusDot.className = "w-2 h-2 rounded-full bg-amber-500 animate-pulse";

            let currentSimLux = 450; // 初期値 450lx (オフィス相当)

            state.demoTimer = setInterval(() => {
                // ランダムに照度を自然変動
                const delta = (Math.random() - 0.48) * 60;
                currentSimLux = Math.max(5, Math.min(12000, currentSimLux + delta));

                // 5%の確率で照明変化のスパイクを生成
                if (Math.random() > 0.95) {
                    currentSimLux = Math.random() > 0.5 ? currentSimLux * 2.5 : currentSimLux * 0.3;
                }

                processNewLuxReading(currentSimLux);
            }, 300);
        }

        // ログ記録
        function logCurrentValue() {
            const now = new Date();
            const timeStr = now.toTimeString().split(' ')[0] + '.' + String(now.getMilliseconds()).padStart(3, '0');
            const luxVal = state.calibratedLux;
            const fcVal = luxVal / FC_CONVERSION_FACTOR;
            const category = getEnvironmentCategory(luxVal).text;

            const newLog = {
                id: Date.now(),
                time: timeStr,
                lux: luxVal,
                fc: fcVal,
                category: category
            };

            state.logs.unshift(newLog); // 最新を先頭に
            if (state.logs.length > 100) state.logs.pop(); // 最大100件保存

            renderLogs();
            showToast("計測値をログに記録しました");
        }

        function renderLogs() {
            logCountBadge.innerText = `${state.logs.length}件`;

            if (state.logs.length === 0) {
                logTableBody.innerHTML = `
                    <tr>
                        <td colspan="4" class="p-4 text-center text-slate-500 italic">記録されたログはありません</td>
                    </tr>
                `;
                return;
            }

            logTableBody.innerHTML = state.logs.map(log => `
                <tr class="hover:bg-slate-800/40 transition-colors">
                    <td class="p-2.5 font-mono-num text-slate-400">${log.time}</td>
                    <td class="p-2.5 font-mono-num font-bold text-emerald-400">${log.lux.toFixed(1)}</td>
                    <td class="p-2.5 font-mono-num text-cyan-400">${log.fc.toFixed(2)}</td>
                    <td class="p-2.5 text-slate-300">${log.category}</td>
                </tr>
            `).join('');
        }

        // CSVエクスポート
        function exportCSV() {
            if (state.logs.length === 0) {
                showToast("出力するログデータがありません");
                return;
            }

            let csvContent = "\uFEFF日時,照度(lx),照度(fc),環境区分\n";
            state.logs.forEach(log => {
                csvContent += `"${log.time}",${log.lux.toFixed(2)},${log.fc.toFixed(2)},"${log.category}"\n`;
            });

            const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `lux_meter_logs_${new Date().toISOString().slice(0,10)}.csv`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);

            showToast("CSVファイルをダウンロードしました");
        }

        // トースト表示ヘルパー
        function showToast(message) {
            const toast = document.getElementById('toast');
            const toastMessage = document.getElementById('toastMessage');
            toastMessage.innerText = message;
            toast.classList.add('show');
            setTimeout(() => {
                toast.classList.remove('show');
            }, 3000);
        }

        // イベントリスナー設定
        function setupEventListeners() {
            // ホールド
            btnHold.addEventListener('click', () => {
                state.isHold = !state.isHold;
                if (state.isHold) {
                    holdBanner.classList.remove('hidden');
                    btnHold.classList.add('bg-amber-600', 'border-amber-500');
                } else {
                    holdBanner.classList.add('hidden');
                    btnHold.classList.remove('bg-amber-600', 'border-amber-500');
                }
            });

            // 単位切替
            btnToggleUnit.addEventListener('click', () => {
                state.unit = state.unit === 'lx' ? 'fc' : 'lx';
                updateUI();
                showToast(`単位を ${state.unit} に切り替えました`);
            });

            // リセット
            btnResetStats.addEventListener('click', () => {
                state.stats = { min: Infinity, max: 0, sum: 0, count: 0 };
                statMinVal.innerText = "0";
                statMaxVal.innerText = "0";
                statAvgVal.innerText = "0";
                statCountVal.innerText = "0";
                showToast("統計データをリセットしました");
            });

            // キャリブレーションスライダー
            sliderCalibration.addEventListener('input', (e) => {
                state.calibration = parseFloat(e.target.value);
                calibValueLabel.innerText = `${state.calibration.toFixed(1)}x`;
                currentCalibDisplay.innerText = `${state.calibration.toFixed(1)}x`;
                updateUI();
            });

            // ログ手動記録
            btnLogCurrent.addEventListener('click', logCurrentValue);

            // CSV出力 & 消去
            btnExportCSV.addEventListener('click', exportCSV);
            btnClearLogs.addEventListener('click', () => {
                state.logs = [];
                renderLogs();
                showToast("ログを全件消去しました");
            });

            // 自動ログの周期設定
            selectAutoLogInterval.addEventListener('change', (e) => {
                const intervalSec = parseInt(e.target.value);
                if (state.autoLogTimer) clearInterval(state.autoLogTimer);

                if (intervalSec > 0) {
                    state.autoLogTimer = setInterval(logCurrentValue, intervalSec * 1000);
                    showToast(`${intervalSec}秒周期の自動記録を開始しました`);
                } else {
                    showToast("自動記録を停止しました");
                }
            });

            // 照度ガイドアコーディオン
            btnToggleRefGuide.addEventListener('click', () => {
                panelRefGuide.classList.toggle('hidden');
                arrowRefGuide.classList.toggle('rotate-180');
            });

            // モードダイアログ表示制御
            btnModeSelector.addEventListener('click', () => modeModal.classList.remove('hidden'));
            btnCloseModal.addEventListener('click', () => modeModal.classList.add('hidden'));

            optSensorMode.addEventListener('click', () => switchMode('SENSOR'));
            optCameraMode.addEventListener('click', () => switchMode('CAMERA'));
            optDemoMode.addEventListener('click', () => switchMode('DEMO'));
        }

        // 初期化処理
        window.onload = () => {
            setupEventListeners();
            // 最初は環境光センサーを試し、不可能な場合はフォールバック
            initAmbientLightSensor();
        };
    </script>
</body>
</html>
